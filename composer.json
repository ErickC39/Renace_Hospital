{
    "name": "utc/hospital-utc",
    "description": "Aplicativo web del Proyecto Hospital (Programación VII, UTC)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Config\\": "app/config/",
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/"
        },
        "files": [
            "app/core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "serve": "php -S localhost:8000 -t public",
        "db:check": "@php bin/db-check.php"
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "sort-packages": true,
        "process-timeout": 0
    }
}
